DJANGO_SECRET_KEY=replace-this-with-a-development-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=
PORT=8000

MYSQL_DATABASE=vehicle_rental
MYSQL_USER=vehicle_rental_user
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
# Set to REQUIRED for a managed public MySQL-compatible database such as TiDB Cloud.
MYSQL_SSL_MODE=

# Brevo email delivery for signup and password-reset OTPs.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=RideHub <no-reply@example.com>

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=RideHub

# Optional one-time administrator bootstrap (keep values only in local env/env files).
RIDEHUB_ADMIN_EMAIL=ridehub@admin.ride
RIDEHUB_ADMIN_PASSWORD=
RIDEHUB_ADMIN_PHONE=9999999999
RIDEHUB_ADMIN_VERIFICATION_EMAIL=business.starkindustries@gmail.com

# Razorpay payment gateway. Paste your Test or Live dashboard credentials below,
# then restart Django. The key secret is kept server-side and is never exposed to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Create this separately while adding the payment.captured webhook in Razorpay Dashboard.
# Webhook URL: https://YOUR_DOMAIN/api/payments/razorpay/webhook/
RAZORPAY_WEBHOOK_SECRET=

# Optional Google Maps JavaScript + Places integration.
# Restrict this browser key by website referrer in Google Cloud Console.
GOOGLE_MAPS_API_KEY=

# Shared HTML email appearance (optional public HTTPS logo).
EMAIL_BRAND_NAME=RideHub
EMAIL_BRAND_LOGO_URL=
