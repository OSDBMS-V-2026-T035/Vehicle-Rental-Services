DJANGO_SECRET_KEY=replace-this-with-a-development-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

MYSQL_DATABASE=vehicle_rental
MYSQL_USER=vehicle_rental_user
MYSQL_PASSWORD=change-me
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Optional email delivery. Without these, OTPs are printed to the Django console in DEBUG mode.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=RideHub <no-reply@example.com>

# Optional Brevo email API (free plan has a daily sending limit; see README).
BREVO_API_KEY=

# Optional Twilio Verify SMS adapter (trial credits only; SMS is paid after trial).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
